# 复制为 .env 后按需修改（也可以直接设置同名环境变量）

# 接口密钥：设置后，上传/修改/删除等写操作需要在请求头携带 X-API-Key
# ORCHARD_API_KEY=请改成一串足够长的随机字符

# 数据目录（数据库、原图、缩略图、分析标注图），默认为项目根目录下的 data/
# ORCHARD_DATA_DIR=./data

# 数据库连接串，默认使用 data 目录下的 SQLite；多人大规模使用可改为 PostgreSQL
# ORCHARD_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/orchard

# 单张照片大小上限（MB）
# ORCHARD_MAX_UPLOAD_MB=60

# 后台分析线程数（建议不超过 CPU 核数）
# ORCHARD_WORKERS=2

# 分析时照片长边缩放到的像素数，越大越精细但越慢
# ORCHARD_ANALYSIS_MAX_SIDE=1280

# 照片与果树档案自动关联的距离阈值（米），RTK 机型可适当调小
# ORCHARD_TREE_MATCH_RADIUS_M=3

# 可选：自训练 ONNX 病害识别模型
# ORCHARD_MODEL_PATH=./models/orchard_disease.onnx
# ORCHARD_MODEL_LABELS=./models/labels.json
# ORCHARD_MODEL_MIN_CONFIDENCE=0.5

# 前端单独部署时允许跨域访问的地址，逗号分隔
# ORCHARD_CORS_ORIGINS=http://localhost:5173
